from flask import Flask
import os

app = Flask(__name__)

@app.route('/')
def home():

    app_name = os.getenv("APP_NAME", "Default App")
    db_user = os.getenv("DB_USER", "Not Set")

    return f"""
    <h1>{app_name}</h1>
    <h2>ConfigMap + Secret Demo</h2>
    <h3>DB User: {db_user}</h3>
    """

if __name__ == '__main__':
    app.run(host='0.0.0.0', port=5000)

